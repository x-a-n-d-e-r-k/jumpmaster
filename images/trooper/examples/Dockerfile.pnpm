# A zone image for a pnpm project. Build it after the trooper image, and add it to the stick's
# allow-list with JM_ALLOWED_IMAGES. Keep the base image's hardening: add tools, and don't add
# setuid binaries, credentials or a different USER.
#
# The trooper itself already runs the pnpm a repository pins in `packageManager` (Corepack,
# fetched and checked on first use), so a pnpm project may need no zone image at all. This one
# bakes a pinned pnpm in instead: no download per drop, and it wins over the Corepack shims. Do
# not run `corepack enable` here: it would put shims back into /usr/local/bin. pnpm 10 still
# switches to a different version a repository pins in `packageManager`, fetching it on first use.
FROM jumpmaster-trooper:dev
RUN cd /tmp && npm pack --silent pnpm@10.18.3 \
 && echo "bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d  pnpm-10.18.3.tgz" | sha512sum -c - \
 && npm i -g --no-audit --no-fund ./pnpm-10.18.3.tgz \
 && rm pnpm-10.18.3.tgz && npm cache clean --force \
 && find / -xdev -type f -perm /6000 -exec chmod a-s {} +
