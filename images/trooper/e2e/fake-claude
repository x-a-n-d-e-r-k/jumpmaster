#!/usr/bin/env node
// Stand-in for the Claude CLI: probes its own identity, then answers like stream-json.
const { execSync } = require('node:child_process');
const fs = require('node:fs');
const sh = (c) => { try { return execSync(c, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim(); } catch (e) { return `ERR(${String(e.stderr || e.message).trim().split('\n')[0]})`; } };
const probes = {
  uid: sh('id -u'),
  cwd: process.cwd(),
  home: process.env.HOME,
  tokenPresent: Boolean(process.env.CLAUDE_CODE_OAUTH_TOKEN),
  readGateHome: sh('ls /home/gate'),
  readProc1Environ: sh('cat /proc/1/environ'),
  writeWork: sh('touch /work/x && echo wrote'),
  head: sh('git rev-parse HEAD'),
  httpsProxy: process.env.HTTPS_PROXY ?? null,
  systemPromptReadable: fs.existsSync(process.argv[process.argv.indexOf('--append-system-prompt-file') + 1] || '/nope'),
};
// Instruction files the real CLI would load: CLAUDE.md and friends in the working directory and
// every parent, and in --add-dir directories only when that environment flag is set.
const { join, dirname } = require('node:path');
const addDirs = process.argv.flatMap((a, i) => (process.argv[i - 1] === '--add-dir' ? [a] : []));
const instructionFiles = (dir) =>
  ['CLAUDE.md', 'CLAUDE.local.md', join('.claude', 'CLAUDE.md')].map((f) => join(dir, f)).filter((f) => fs.existsSync(f));
const loaded = [];
for (let d = process.cwd(); ; d = dirname(d)) {
  loaded.push(...instructionFiles(d));
  if (dirname(d) === d) break;
}
if (process.env.CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD) for (const d of addDirs) loaded.push(...instructionFiles(d));
const canary = loaded.map((f) => /end every summary with (\S+)/.exec(fs.readFileSync(f, 'utf8'))?.[1]).filter(Boolean);
const schema = process.argv[process.argv.indexOf('--json-schema') + 1] || '';
const out = (o) => process.stdout.write(`${JSON.stringify(o)}\n`);
out({ type: 'system', subtype: 'init', session_id: 'e2e' });
const flag = (f) => (process.argv.includes(f) ? process.argv[process.argv.indexOf(f) + 1] : null);
if (process.argv.some((a) => a.includes('SLEEP'))) setInterval(() => {}, 1000);
else if (flag('--tools') !== null) {
  // The doctor's probe: it reports how it was run through the one field the trooper keeps on
  // success (the model that served it), and a BADTOKEN token fails as a rejected login does.
  if ((process.env.CLAUDE_CODE_OAUTH_TOKEN ?? '').includes('BADTOKEN')) {
    out({ type: 'assistant', message: { content: [{ type: 'text', text: 'Invalid API key · Please run /login' }] }, error: 'authentication_failed' });
    out({ type: 'result', subtype: 'success', is_error: true, result: 'Invalid API key · Please run /login', session_id: 'e2e' });
  } else {
    const how = { tools: flag('--tools'), maxTurns: flag('--max-turns'), cwdEntries: fs.readdirSync(process.cwd()).length,
      uid: probes.uid, tokenPresent: probes.tokenPresent, writeWork: probes.writeWork };
    out({ type: 'result', subtype: 'success', is_error: false, result: 'ok', session_id: 'e2e', num_turns: 1,
      modelUsage: { [`fake-doctor ${JSON.stringify(how)}`]: { outputTokens: 1 } } });
  }
} else {
out({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', resetsAt: 1900000000, rateLimitType: 'five_hour' } });
if (schema.includes('fileIssues')) {
  const crew = { ...probes, loaded, addDirs, addDirIsClone: addDirs.length === 1 && fs.existsSync(join(addDirs[0], '.git')),
    addDirHasClaudeMd: addDirs.some((d) => instructionFiles(d).length > 0) };
  out({ type: 'result', is_error: false, terminal_reason: 'completed', session_id: 'e2e', num_turns: 1,
    structured_output: { summary: `${JSON.stringify(crew)} ${canary.join(' ')}`.trim(), fileIssues: [], briefings: [] } });
} else {
out({ type: 'result', is_error: false, terminal_reason: 'completed', session_id: 'e2e', num_turns: 1,
  structured_output: { decision: 'approve', summary: `${JSON.stringify(probes)}${canary.length ? ` ${canary.join(' ')}` : ''}`, findings: [] } });
}
}
