# Jumpmaster's compose file, as each release publishes it. The release workflow renders this
# template with scripts/render-compose.ts: each image placeholder becomes the release's image pinned
# by its @sha256 index digest, and rendering fails if any image is left unpinned or any port is
# published beyond 127.0.0.1. The template is not a .yaml file so the repository's pin scan never
# mistakes its placeholders for images.
#
# `docker compose up` works in an empty directory: the bootstrap service runs first, as the host
# user, and makes everything the server and the stick need next to compose.yaml:
#   secrets/                          mode 0700; the machine secrets (join_token, operator_token,
#                                     vault_key, 0600) and any credential you keep as a file
#   data/                             mode 0700; the database
#   config/                           a config file here means file mode (`jumpmaster init`)
# Then open http://127.0.0.1:7420/setup with the setup code the server prints. Credentials are
# entered in the browser (the vault, keyed by secrets/vault_key) or written to secrets/ by name
# (claude_token, github_author_token, github_reviewer_token, github_read_token): a file wins.
#
# .env is optional: JM_UID and JM_GID (default 1000) are the host user who owns these files, and
# the stick settings in .env.example. An M4 install upgrades by replacing this file: its secrets/,
# config/ and data/ keep working, and init's old block in .env is unused and may be deleted.
#
# Only the stick mounts the Docker socket, which is root on the host. The UI is on 127.0.0.1 only.
# The chat service reaches the internet only through chat-egress (the Anthropic API and the forge).
name: jumpmaster

services:
  bootstrap:
    image: "{{image jumpmaster-server}}"
    user: "${JM_UID:-1000}:${JM_GID:-1000}"
    command: ["bootstrap"]
    restart: "no"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      JM_INSTALL_DIR: /install
    volumes:
      - .:/install

  jumpmaster:
    image: "{{image jumpmaster-server}}"
    user: "${JM_UID:-1000}:${JM_GID:-1000}"
    command: ["serve"]
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    ports:
      - "127.0.0.1:7420:7420"
    environment:
      # A config file there means file mode; without one the config lives in the database.
      JM_CONFIG: /config/jumpmaster.config.json
      JM_DATA_DIR: /data
      # Credentials are read from here by name; a file wins over the vault.
      JM_SECRETS_DIR: /secrets
      JM_LISTEN_HOST: 0.0.0.0
      JM_ALLOWED_HOSTS: 127.0.0.1:7420,localhost:7420
      JM_JOIN_TOKEN_FILE: /secrets/join_token
      JM_OPERATOR_TOKEN_FILE: /secrets/operator_token
      JM_VAULT_KEY_FILE: /secrets/vault_key
      # The crew chat's service, reached on chat-net.
      JM_CHAT_SERVICE_URL: http://chat:7431
    networks:
      - default
      - chat-net
    volumes:
      - ./data:/data
      - ./config:/config:ro
      - ./secrets:/secrets:ro
    # Healthy once the UI answers on the loopback it listens on (any status below 500).
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:7420/login',{redirect:'manual'}).then((r)=>process.exit(r.status<500?0:1),()=>process.exit(1))"
      # Add start_interval: 2s once Docker Engine 25 is the floor (Compose refuses the key on older
      # engines); until then the stick waits up to one interval after the server is ready.
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 120s
    depends_on:
      bootstrap:
        condition: service_completed_successfully
    restart: unless-stopped

  stick:
    image: "{{image jumpmaster-stick}}"
    read_only: true
    tmpfs:
      - /tmp
    environment:
      JM_SERVER_URL: http://jumpmaster:7420
      JM_JOIN_TOKEN_FILE: /secrets/join_token
      JM_STICK_NAME: stick
      # The trooper count asked for at enrollment; the operator changes it on the sticks page.
      JM_SLOTS: ${JM_SLOTS:-1}
      # The most the sticks page may set (empty: max(4, JM_SLOTS)).
      JM_MAX_SLOTS: ${JM_MAX_SLOTS:-}
      # Images only by digest, each verified with cosign against this repository's release
      # workflow, or pinned by the operator in JM_ALLOWED_IMAGES (name@sha256:…, comma-separated).
      JM_IMAGE_POLICY: signed
      JM_ALLOWED_IMAGES: ${JM_ALLOWED_IMAGES:-}
      JM_EGRESS_IMAGE: "{{image jumpmaster-egress}}"
      # Each egress-controlled drop takes a /28 from this pool (empty: the stick's default).
      JM_DROP_SUBNET_POOL: ${JM_DROP_SUBNET_POOL:-}
      # The stick's egress ceiling: the most any drop or push here may reach (empty: none).
      JM_EGRESS_CEILING: ${JM_EGRESS_CEILING:-}
      # The enrollment, the Sigstore trust root and the verify cache.
      JM_STATE_DIR: /state
    volumes:
      - ${DOCKER_SOCKET:-/var/run/docker.sock}:/var/run/docker.sock
      - ./secrets:/secrets:ro
      - jm-stick:/state
    depends_on:
      bootstrap:
        condition: service_completed_successfully
      jumpmaster:
        condition: service_healthy
    restart: unless-stopped

  # The crew chat: one Claude process per turn, reading the zones' code. It holds no secrets at rest
  # (each turn brings its Claude token and a short-lived MCP token), mounts no secrets directory and
  # no Docker socket, and writes only to its two volumes. It is on chat-net alone, which is
  # internal: the server reaches it there, and everything else leaves through chat-egress. Root
  # keeps only what it needs to run git and Claude as the agent uid (setpriv) and to stop them.
  chat:
    image: "{{image jumpmaster-trooper}}"
    entrypoint: ["node", "/opt/trooper/chat/main.js"]
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - SETUID
      - SETGID
      - KILL
    environment:
      JM_CHAT_LISTEN: 0.0.0.0:7431
      HTTPS_PROXY: http://chat-egress:3128
      HTTP_PROXY: http://chat-egress:3128
      NO_PROXY: jumpmaster
      # Node's own fetch (the health probes) honours the proxy variables too.
      NODE_USE_ENV_PROXY: "1"
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1"
      DISABLE_AUTOUPDATER: "1"
    volumes:
      - chat-repos:/chat/repos
      - chat-sessions:/home/agent/.claude
    networks:
      - chat-net
    depends_on:
      chat-egress:
        condition: service_started
    restart: unless-stopped

  # The chat's only way out: the Anthropic API and the forge, nothing else. It listens on its fixed
  # chat-net address only, and reaches the internet over the default network.
  chat-egress:
    image: "{{image jumpmaster-egress}}"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      JM_EGRESS_MODE: enforce
      JM_EGRESS_ALLOW: api.anthropic.com,github.com,api.github.com
      JM_EGRESS_BIND: ${JM_CHAT_EGRESS_ADDR:-172.31.254.2}
    networks:
      default:
      chat-net:
        ipv4_address: ${JM_CHAT_EGRESS_ADDR:-172.31.254.2}
    restart: unless-stopped

  # `docker compose --profile init run --rm init --repo owner/name`: writes config/ (file mode) and
  # the generated secrets into this directory, as the host user. Never started by `up`.
  init:
    image: "{{image jumpmaster-server}}"
    profiles: ["init"]
    user: "${JM_UID:-1000}:${JM_GID:-1000}"
    entrypoint: ["jumpmaster", "init"]
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      JM_INSTALL_DIR: /install
    volumes:
      - .:/install

volumes:
  jm-stick:
  chat-repos:
  chat-sessions:

networks:
  # Internal: no route out. Change the subnet (and JM_CHAT_EGRESS_ADDR, inside it) only if it
  # overlaps a network of yours.
  chat-net:
    internal: true
    ipam:
      config:
        - subnet: ${JM_CHAT_SUBNET:-172.31.254.0/28}
