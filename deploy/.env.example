# Jumpmaster's compose settings: .env next to compose.yaml. Every line is optional, and it holds no
# secret: tokens live in secrets/, one per file, or in the vault (entered in the browser).

# Optional. The host user and group that own secrets/, config/ and data/; the server, bootstrap and
# init run as them. The default is 1000:1000, the first user on most Linux hosts. If yours differs,
# bootstrap stops and prints the line that writes them:
#   printf 'JM_UID=%s\nJM_GID=%s\n' "$(id -u)" "$(id -g)" > .env
#JM_UID=1000
#JM_GID=1000

# Optional. The Docker socket the stick drives (the default suits a rootful Linux engine and
# Docker Desktop). The stick is the only container that mounts it: it is root on the host.
#DOCKER_SOCKET=/var/run/docker.sock

# Optional. How many drops the stick runs at once (default 1).
#JM_SLOTS=1

# Optional. The IPv4 pool each egress-controlled drop takes a /28 from. Change it only if it
# overlaps a network of yours (see the install runbook, "Address pools").
#JM_DROP_SUBNET_POOL=

# Optional. Images you built yourself, pinned by digest (name@sha256:…, comma-separated): the stick
# runs a pinned image without a release signature (see the install runbook, "Pinning an image").
#JM_ALLOWED_IMAGES=

# Upgrading from M4: an M4 `jumpmaster init` wrote a block of lines between
# "# jumpmaster init: begin" and "# jumpmaster init: end" (JM_REVIEWER_TOKEN_* and
# JM_READ_TOKEN_*). This compose file no longer reads them: the block is unused and may be deleted.
# So may a leftover secrets/github_reviewer_token beside a starter zone, which never uses it.
