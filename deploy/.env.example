# Jumpmaster's compose settings: .env next to compose.yaml. It holds no secret: tokens live in
# secrets/, one per file. The install runbook writes the first two lines with
#   printf 'JM_UID=%s\nJM_GID=%s\n' "$(id -u)" "$(id -g)" > .env

# The host user and group that own secrets/, config/ and data/. The server and init run as them.
JM_UID=1000
JM_GID=1000

# Optional. The Docker socket the stick drives (the default suits a rootful Linux engine and
# Docker Desktop). The stick is the only container that mounts it: it is root on the host.
#DOCKER_SOCKET=/var/run/docker.sock

# Optional. How many drops the stick runs at once (default 1).
#JM_SLOTS=1

# Optional. The IPv4 pool each egress-controlled drop takes a /28 from. Change it only if it
# overlaps a network of yours (see the install runbook, "Address pools").
#JM_DROP_SUBNET_POOL=

# Optional. Images you built yourself, pinned by digest (name@sha256:…, comma-separated): the stick
# runs a pinned image without a release signature (see the install runbook, "Pinning an image").
#JM_ALLOWED_IMAGES=
